{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api"
    },
    {
      "source": "/robots.txt",
      "destination": "/api"
    },
    {
      "source": "/spares",
      "destination": "/spares.html"
    },
    {
      "source": "/guides",
      "destination": "/guides.html"
    },
    {
      "source": "/catalog",
      "destination": "/index.html#catalog"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    }
  ]
}
