# Aura3D Labs — Production Environment Configuration
# Copy this file to .env for local overrides, or set these variables in Vercel Project Settings.

# ==============================================================================
# SECURE ADMIN CREDENTIALS
# ==============================================================================
# Admin Username / Operator ID for the /admin terminal
ADMIN_USERNAME=admin

# Master Security Key / Password (minimum 8 characters, recommended 12+)
ADMIN_PASSWORD=aura3d@2026

# ==============================================================================
# FIREBASE DATABASE CONFIGURATION (Persistent Storage for Vercel)
# ==============================================================================
# Option 1: Google Cloud Firestore (Recommended)
# Find your Project ID in Firebase Console -> Project Settings -> General
FIREBASE_PROJECT_ID=

# Web API Key from Firebase Console -> Project Settings -> General -> Web API Key
FIREBASE_API_KEY=

# Option 2: Firebase Realtime Database (Alternative)
# e.g., https://your-project-id-default-rtdb.firebaseio.com
FIREBASE_DATABASE_URL=

# Note: If no Firebase variables are provided, Aura3D Labs will gracefully fall back
# to local data/products.json file storage.

# ==============================================================================
# SERVER SETTINGS
# ==============================================================================
PORT=3000
NODE_ENV=production
